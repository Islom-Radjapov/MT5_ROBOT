#property copyright "Islom Radjapov"
#property link      "https://t.me/IslomRadjapov"
#property version   "1.00"
#property strict

input string Password;
input double TakeProfit6 = 10;
input double TakeProfit7 = 2;
string SYMBOL = "EURUSD";



int Count_buy_orders() {
   int num_buy = 0;
   for(int x = 0; x <= OrdersTotal(); x++) {
         if (OrderSelect(x, SELECT_BY_POS) == true) {
            if (OrderType() == OP_BUY) {
               num_buy = num_buy  + 1;
            }
         }
   }
   return num_buy;
}


int Count_sell_orders() {
   int num_sell = 0;
   for(int x = 0; x <= OrdersTotal(); x++) {
         if (OrderSelect(x, SELECT_BY_POS) == true) {
            if (OrderType() == OP_SELL) {
               num_sell = num_sell + 1;
            }
         }
   }
   return num_sell;
}


int last_order_buy() {
   datetime lastime = NULL;
   for (int x = OrdersTotal(); x >= 0; x--) {
      if (OrderSelect(x, SELECT_BY_POS) == true) {
         if (OrderType() == OP_BUY) {
            if (lastime == NULL || lastime < OrderOpenTime()) {
               lastime = OrderOpenTime();
            }
         }
      }
   }
   for (int y = OrdersTotal(); y >= 0; y--) {
      if (OrderSelect(y, SELECT_BY_POS) == true) {
         if (OrderOpenTime() == lastime) {
            return OrderTicket();
         }
      }

   }
   return NULL;
}




int last_order_sell() {
   datetime lastime = NULL;
   for (int x = OrdersTotal(); x >= 0; x--) {
      if (OrderSelect(x, SELECT_BY_POS) == true) {
         if (OrderType() == OP_SELL) {
            if (lastime == NULL || lastime < OrderOpenTime()) {
               lastime = OrderOpenTime();
            }
         }
      }
   }
   for (int y = OrdersTotal(); y >= 0; y--) {
      if (OrderSelect(y, SELECT_BY_POS) == true) {
         if (OrderOpenTime() == lastime) {
            return OrderTicket();
         }
      }

   }
   return NULL;
}


void Add_order_buy(){
   if (OrderSelect(last_order_buy(), SELECT_BY_TICKET) == true) {
         if (OrderLots() == 0.01) {
            if (OrderProfit() <= -1) {
               int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.02, Ask, 10, 0, 0, NULL, 0, 0, Green);
            }
         }
         else if (OrderLots() == 0.02) {
