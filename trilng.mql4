void OnTick() {

   if (Count_buy_orders() == 0) {
      int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.01, Ask, 10, 0, 0, NULL, 0, 0, Green);
   }
   if (Count_sell_orders() == 0) {
      int SellOrder = OrderSend(SYMBOL, OP_SELL, 0.01, Bid, 10, 0, 0, NULL, 0, 0, Red);
   }


   Add_order_buy();
   Add_order_sell();

   if (OrderSelect(last_order_buy(), SELECT_BY_TICKET) == true) {
      if (OrderLots() * 2 *  100 < OrderProfit()) {
         while (OrdersTotal() != 0) {
            if (OrderSelect(OrdersTotal() - 1, SELECT_BY_POS) == true) {
               if (OrderType() == OP_BUY) {
                  int  CloseBuyOrders = OrderClose(OrderTicket(), OrderLots(), Bid, 3, Red);
               }
            }
         }
      }
   }

   if (OrderSelect(last_order_sell(), SELECT_BY_TICKET) == true) {
      if (OrderLots() * 2 *  100 < OrderProfit()) {
         while (OrdersTotal() != 0) {
            if (OrderSelect(OrdersTotal() - 1, SELECT_BY_POS) == true) {
               if (OrderType() == OP_SELL) {
                  int CloseSellOrder = OrderClose(OrderTicket(), OrderLots(), Ask, 3, Green);
               }
            }
         }
      }
   }

}