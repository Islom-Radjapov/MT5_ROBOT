            }
         }
         else if (OrderLots() == 0.08) {
            if (OrderProfit() <= -8) {
               int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.13, Ask, 10, 0, 0, NULL, 0, 0, Green);
            }
         }
         else if (OrderLots() == 0.13) {
            if (OrderProfit() <= -13) {
               int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.21, Ask, 10, 0, 0, NULL, 0, 0, Green);
            }
         }
         else if (OrderLots() == 0.21) {
            if (OrderProfit() <= -21) {
               int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.34, Ask, 10, 0, 0, NULL, 0, 0, Green);
            }
         }
         else if (OrderLots() == 0.34) {
            if (OrderProfit() <= -34) {
               int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.55, Ask, 10, 0, 0, NULL, 0, 0, Green);
            }
         }
         else if (OrderLots() == 0.55) {
            if (OrderProfit() <= -55) {
               int BuyOrder = OrderSend(SYMBOL, OP_BUY, 0.89, Ask, 10, 0, 0, NULL, 0, 0, Green);
            }
         }
   }
}



void Add_order_sell() {
   if (OrderSelect(last_order_sell(), SELECT_BY_TICKET) == true) {
      if (OrderLots() == 0.01) {
         if (OrderProfit() <= -1) {
